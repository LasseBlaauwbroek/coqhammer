DECLARE PLUGIN "hammer_plugin"

{

open Ltac_plugin

let hammer_version_string = "CoqHammer (dev) for Coq 8.11"

open Feedback
let () = Mltop.add_known_plugin (fun () ->
  Flags.if_verbose msg_info Pp.(str hammer_version_string))
  "Hammer"
;;

open Hammer_main

}

TACTIC EXTEND Hammer_tac
| [ "fol" ] -> { print_fol_tac () }
END

